# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# Shopify Headless (Fase 5+)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=

# ── Control Plane ──────────────────────────────────────────
# Real Kubernetes ops are OFF by default (safe for public/Vercel).
# Enable ONLY on a trusted local lab with Docker/kind.
CONTROL_PLANE_REAL_OPS_ENABLED=false

# Required when REAL_OPS=true (min 32 chars). Used to encrypt kubeconfigs at rest.
# CONTROL_PLANE_SECRET_KEY=

# Local session auth (lab). Change before any shared environment.
# CONTROL_PLANE_ADMIN_PASSWORD=
# CONTROL_PLANE_OPERATOR_PASSWORD=
# CONTROL_PLANE_VIEWER_PASSWORD=
# CONTROL_PLANE_SESSION_SECRET=

# Namespace allowed for Control Plane write operations
CONTROL_PLANE_NAMESPACE=control-plane-demo

# Dangerous: never set on public Vercel unless you accept the risk.
# CONTROL_PLANE_ALLOW_VERCEL_REAL_OPS=false
