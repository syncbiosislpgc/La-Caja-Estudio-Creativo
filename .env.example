# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# Shopify Headless (Fase 5+)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=

# ── Control Plane ──────────────────────────────────────────
# Local kind/kubeconfig path — OFF by default (especially on Vercel).
CONTROL_PLANE_REAL_OPS_ENABLED=false
# CONTROL_PLANE_SECRET_KEY=
# CONTROL_PLANE_ADMIN_PASSWORD=
# CONTROL_PLANE_OPERATOR_PASSWORD=
# CONTROL_PLANE_VIEWER_PASSWORD=
# CONTROL_PLANE_SESSION_SECRET=
CONTROL_PLANE_NAMESPACE=control-plane-demo
# CONTROL_PLANE_ALLOW_VERCEL_REAL_OPS=false

# ── Cloud lab (Vercel → remote-ops → K3s) ──────────────────
# Enable ONLY after OCI VM + Cloudflare Tunnel are healthy.
CONTROL_PLANE_REMOTE_OPS_ENABLED=false
# CONTROL_PLANE_REMOTE_OPS_URL=https://cp-lab.example.com
# CONTROL_PLANE_REMOTE_OPS_TOKEN=
# CONTROL_PLANE_REMOTE_CLUSTER_ID=remote-k3s-lab
# CONTROL_PLANE_REMOTE_CLUSTER_NAME=cloud-lab-k3s
# CONTROL_PLANE_REMOTE_CLUSTER_REGION=oci-free

# ── remote-ops service (on the lab VM only) ────────────────
# REMOTE_OPS_TOKEN=
# REMOTE_OPS_BIND=127.0.0.1
# REMOTE_OPS_PORT=8787
# TUNNEL_TOKEN=
